{
  "name": "concrete-design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @y-sebaei/concrete-ui && npm run build -w boxoffice-console",
    "dev:ui": "npm run storybook -w @y-sebaei/concrete-ui",
    "dev:console": "npm run dev -w boxoffice-console",
    "tokens": "npm run tokens -w @y-sebaei/concrete-ui",
    "tokens:check": "npm run tokens:check -w @y-sebaei/concrete-ui",
    "contrast": "npm run contrast -w @y-sebaei/concrete-ui",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/ui/tsconfig.json --pretty false && tsc -p apps/console/tsconfig.app.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --project a11y",
    "storybook:build": "npm run storybook:build -w @y-sebaei/concrete-ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build -w @y-sebaei/concrete-ui && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.1",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
